{
  "name": "quantified-self",
  "version": "1.0.0",
  "description": "Personal daily event and habit tracker with minimal interaction — built around Apple Watch, AirPods, Apple Shortcuts, Todoist, and Everhour. Centralized view in Obsidian.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "workspaces": [
    "sheets/ts"
  ],
  "scripts": {
    "format": "npm run format:gs && npm run format:ts",
    "format:gs": "prettier --write --parser babel \"**/*.gs\"",
    "format:ts": "prettier --write --no-error-on-unmatched-pattern \"sheets/ts/**/*.ts\"",
    "typecheck": "npm --workspace sheets/ts run typecheck",
    "test": "npm --workspace sheets/ts test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlbertoMata/quantified-self.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AlbertoMata/quantified-self/issues"
  },
  "homepage": "https://github.com/AlbertoMata/quantified-self#readme",
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
